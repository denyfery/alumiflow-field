# Local development defaults for the Android emulator.
# If you prefer adb reverse for the backend, 127.0.0.1:8000 also works after:
#   adb reverse tcp:8000 tcp:8000
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/mobile/v1

# Cached login may be used while offline only if the device has verified with the server
# within this window. This limits the window for a remotely-revoked account/device.
EXPO_PUBLIC_OFFLINE_AUTH_MAX_HOURS=24
